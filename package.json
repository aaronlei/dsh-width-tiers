{
  "name": "dsh-width-tiers",
  "version": "2.0.1",
  "description": "DSH Web client plugin: chat content width tiers (standard / medium / wide / ultra / full / custom) with a floating picker button. Mounts into the app's shell.overlay slot on DSH 0.2.x and drives the native width axis, so the built-in drag handles keep working. UI copy follows the app language (zh / en / ja / es / fr / de / ru / pt).",
  "license": "MIT",
  "author": "aaronlei",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "width",
    "tiers",
    "widescreen",
    "table",
    "layout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronlei/dsh-width-tiers.git"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:client": "node scripts/verify-client.mjs",
    "prepack": "tsdown"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "jsdom": "^30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
